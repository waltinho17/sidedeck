{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideDeck",
  "version": "1.3.0",
  "identifier": "com.sidedeck.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SideDeck",
        "url": "settings.html",
        "width": 920,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/index.html": "web/index.html",
      "../src/styles.css": "web/styles.css",
      "../src/main.js": "web/main.js",
      "../src/fonts.css": "web/fonts.css",
      "../src/assets/fonts/*": "web/assets/fonts/",
      "videos/*": "videos/",
      "adb/*": "adb/",
      "android/SideDeck-Display.apk": "android/SideDeck-Display.apk"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "SideDeck",
    "shortDescription": "Hardware monitor on your phone screen"
  },
  "mainBinaryName": "SideDeck"
}
